<?xml version="1.0"?>
<launch>
  <arg name="camera_info_url"
    default="file://$(find kuroko_bringup)/config/usb_camera_info.yaml"/>
  <arg name="use_rectify" default="false"/>

  <!-- Start USB camera node -->
  <!-- The widest viewing angle at this resolution. -->
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen" ns="camera" respawn="true">
    <param name="video_device" value="/dev/video0"/>
    <param name="brightness" value="0"/>
    <param name="contrast" value="20"/>
    <param name="saturation" value="40"/>
    <param name="sharpness" value="0"/>
    <param name="image_width" value="1280"/>
    <param name="image_height" value="720"/>
    <param name="framerate" value="30"/>
    <param name="pixel_format" value="mjpeg"/>
    <param name="camera_name" value="camera"/>
    <param name="camera_frame_id" value="usb_cam_frame"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
    <remap from="~image_raw" to="/camera/raw/image"/>
    <remap from="~camera_info" to="/camera/raw/camera_info"/>
  </node>
  <!-- Resize images to 384*216 -->
  <node name="image_resizer" pkg="nodelet" type="nodelet" args="standalone image_proc/resize" ns="camera">
    <param name="scale_width" type="double" value="0.3"/>
    <param name="scale_height" type="double" value="0.3"/>
    <remap from="image" to="/camera/raw/image"/>
    <remap from="camera_info" to="/camera/raw/camera_info"/>
    <remap from="~image" to="/camera/resized/image"/>
    <remap from="~camera_info" to="/camera/resized/camera_info"/>
  </node>
  <!-- Rectify resized image -->
  <group if="$(arg use_rectify)">
    <node name="rectify" pkg="image_proc" type="image_proc" output="screen" ns="camera/resized">
      <remap from="image_raw" to="/camera/resized/image"/>
      <remap from="camera_info" to="/camera/resized/camera_info"/>
      <remap from="image_rect" to="/camera/resized/image_rect"/>
      <remap from="image_rect_color" to="/camera/resized/image_rect_color"/>
    </node>
  </group>
</launch>
