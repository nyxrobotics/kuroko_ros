  <joint name="imu_joint" type="fixed">
    <parent link="waist_link"/>
    <child link="imu_link"/>
    <origin rpy="0 0 0" xyz="-0.04 0 -0.01"/>
  </joint>
  <link name="imu_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.01 0.01 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.013"/>
      <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-05"/>
    </inertial>
  </link>
  <!-- gazebo extensions -->
  <gazebo reference="imu_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="imu_link">
    <material>Gazebo/Gray</material>
  </gazebo>
  <gazebo>
    <plugin filename="libhector_gazebo_ros_imu.so" name="imu_controller">
      <alwaysOn>true</alwaysOn>
      <updateRate>400</updateRate>
      <bodyName>imu_link</bodyName>
      <topicName>/kuroko/sensors/imu/data</topicName>
      <serviceName>/kuroko/sensors/imu/service</serviceName>
      <frameId>imu_link</frameId>
      <gaussianNoise>0</gaussianNoise>
      <xyzOffset>0 0 0</xyzOffset>
      <rateOffset>0 0 0</rateOffset>
      <rpyOffset>0 0 0</rpyOffset>
    </plugin>
    <plugin filename="libhector_gazebo_ros_magnetic.so" name="magnetic_controller">
      <alwaysOn>true</alwaysOn>
      <updateRate>400</updateRate>
      <bodyName>imu_link</bodyName>
      <topicName>/kuroko/sensors/imu/mag</topicName>
      <frameId>imu_link</frameId>
      <useMagneticFieldMsgs>true</useMagneticFieldMsgs>
      <magnitude>0.000047</magnitude>
      <declination>-7.81</declination>
      <inclination>49.48</inclination>
      <offset>0 0 0</offset>
      <drift>0 0 0</drift>
      <driftFrequency>0 0 0</driftFrequency>
      <gaussianNoise>0 0 0</gaussianNoise>
    </plugin>
  </gazebo>
  <joint name="camera_base" type="fixed">
    <parent link="waist_link"/>
    <child link="camera_base_link"/>
    <origin rpy="0 0 0" xyz="0.07 0 -0.026"/>
  </joint>
  <link name="camera_base_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.002 0.01 0.01"/>
      </geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.002 0.01 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-05"/>
    </inertial>
  </link>
  <joint name="camera_frame" type="fixed">
    <origin rpy="0 0 0" xyz="0.001 0 0"/>
    <parent link="camera_base_link"/>
    <child link="camera_frame_link"/>
  </joint>
  <link name="camera_frame_link"/>
  <joint name="camera_optical" type="fixed">
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0.001 0 0"/>
    <parent link="camera_base_link"/>
    <child link="camera_optical_link"/>
  </joint>
  <link name="camera_optical_link"/>
  <!-- gazebo for camera -->
  <gazebo reference="camera_frame_link">
    <sensor name="camera_camera_cam" type="camera">
      <camera name="camera">
        <horizontal_fov>2.20</horizontal_fov>
        <image>
          <width>384</width>
          <height>216</height>
          <format>B8G8R8</format>
        </image>
        <distortion>
          <k1>-0.011469</k1>
          <k2>-0.009562</k2>
          <p1>0.000937</p1>
          <p2>-0.001691</p2>
          <k3>0.0</k3>
        </distortion>
      </camera>
      <plugin filename="libgazebo_ros_camera.so" name="camera_camera_plugin">
        <alwaysOn>true</alwaysOn>
        <updateRate>30</updateRate>
        <cameraName>camera</cameraName>
        <imageTopicName>resized/image</imageTopicName>
        <cameraInfoTopicName>resized/camera_info</cameraInfoTopicName>
        <frameName>camera_optical_link</frameName>
        <hackBaseline>0</hackBaseline>
        <autoDistortion>true</autoDistortion>
        <borderCrop>true</borderCrop>
      </plugin>
    </sensor>
  </gazebo>
  <joint name="tfluna_joint" type="fixed">
    <parent link="waist_link"/>
    <child link="tfluna_link"/>
    <origin rpy="0 0 0" xyz="0.07 0 -0.044"/>
  </joint>
  <link name="tfluna_link">
    <visual>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.002 0.01 0.01"/>
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <box size="0.002 0.01 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="0.01"/>
      <inertia ixx="1e-05" ixy="0.0" ixz="0.0" iyy="1e-05" iyz="0.0" izz="1e-05"/>
    </inertial>
  </link>
  <gazebo reference="tfluna_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="tfluna_link">
    <sensor name="tfluna" type="ray">
      <always_on>true</always_on>
      <update_rate>10</update_rate>
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <ray>
        <scan>
          <horizontal>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle> 0.01</max_angle>
          </horizontal>
          <vertical>
            <samples>5</samples>
            <resolution>1</resolution>
            <min_angle>-0.01</min_angle>
            <max_angle> 0.01</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.03</min>
          <max>8.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin filename="libgazebo_ros_range.so" name="gazebo_ros_tfluna_controller">
        <gaussianNoise>0.005</gaussianNoise>
        <alwaysOn>true</alwaysOn>
        <updateRate>10</updateRate>
        <topicName>/kuroko/sensors/range</topicName>
        <frameName>tfluna_link</frameName>
        <radiation>INFRARED</radiation>
        <fov>0.02</fov>
      </plugin>
    </sensor>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_dc_motor.so" name="gazebo_ros_control">
      <robotNamespace>kuroko</robotNamespace>
      <robotSimType>gazebo_dc_motor/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>false</legacyModeNS>
    </plugin>
  </gazebo>
</robot>
