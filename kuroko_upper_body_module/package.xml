<?xml version="1.0"?>
<package format="2">
  <name>kuroko_upper_body_module</name>
  <version>0.0.0</version>
  <description> This module performs the movements of the upper body joints. It also calculates the IMU value minus the joint movements. This module can be used by loading it with kuroko_device_manager. </description>
  <author email="nyxroboticss@gmail.com">nyxrobotics</author>
  <maintainer email="nyxroboticss@gmail.com">nyxrobotics</maintainer>
  <license>Apache 2.0</license>
  <url type="website">https://github.com/nyxrobotics</url>
  <url type="repository">https://github.com/nyxrobotics/kuroko_ros</url>
  <url type="bugtracker">https://github.com/nyxrobotics/kuroko_ros/issues</url>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>robotis_controller_msgs</depend>
  <depend>cmake_modules</depend>
  <depend>robotis_framework_common</depend>
  <depend>robotis_device</depend>
  <depend>robotis_math</depend>
  <depend>boost</depend>
  <depend>eigen</depend>
</package>
