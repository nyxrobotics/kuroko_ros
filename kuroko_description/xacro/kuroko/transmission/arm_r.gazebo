<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="${XACRO_DIR}/physics/default_gazebo_params.xacro"/>
  <xacro:macro name="arm_r_gazebo" params="gazebo_hw_interface">
    <xacro:default_motor_transmission joint_name="shoulder_r_pitch" gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="shoulder_r_roll" gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="elbow_r_front" gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="elbow_r_rear" gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_link_collision link_name="shoulder_r_pitch_link" friction="0.01"/>
    <xacro:default_link_collision link_name="shoulder_r_roll_link" friction="0.01"/>
    <xacro:default_link_collision link_name="elbow_r_front_link" friction="0.01"/>
    <xacro:default_link_collision link_name="elbow_r_rear_link" friction="0.01"/>
  </xacro:macro>
</robot>
