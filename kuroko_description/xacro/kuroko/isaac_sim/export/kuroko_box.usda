def PhysicsScene "PhysicsScene"
{
    custom float physics:timeStepsPerSecond = 200
    custom token physxScene:broadphaseType = "GPU"
    custom token physxScene:collisionSystem = "PCM"
    custom bool physxScene:enableGPUDynamics = 0
    custom int physxScene:maxPositionIterationCount = 32
    custom int physxScene:maxVelocityIterationCount = 1
    custom int physxScene:minPositionIterationCount = 32
    custom int physxScene:minVelocityIterationCount = 1
    custom token physxScene:solverType = "PGS"
    custom float physxScene:timeStepsPerSecond = 200
}

