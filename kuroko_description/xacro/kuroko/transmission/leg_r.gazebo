<?xml version="1.0"?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="PHYSICS_DIR" value="$(cwd)/../physics" />
  <xacro:include filename="${PHYSICS_DIR}/default_gazebo_params.xacro"/>
  <xacro:macro name="leg_r_gazebo" params="gazebo_hw_interface">
    <xacro:default_motor_transmission joint_name="hip_r_roll"
      gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="hip_r_pitch"
      gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="thigh_r_active"
      gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="shin_r_active"
      gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="ankle_r_roll"
      gazebo_hw_interface="${gazebo_hw_interface}"/>
    <xacro:default_motor_transmission joint_name="ankle_r_yaw"
      gazebo_hw_interface="${gazebo_hw_interface}"/>

    <xacro:implicit_joint joint_name="thigh_r_middle_passive"/>
    <xacro:implicit_joint joint_name="thigh_r_rear_passive"/>
    <xacro:implicit_joint joint_name="knee_r_passive"/>
    <xacro:implicit_joint joint_name="shin_r_front_passive"/>
    <xacro:implicit_joint joint_name="shin_r_rear_passive"/>
    <xacro:implicit_joint joint_name="ankle_r_pitch_passive"/>

    <xacro:default_link_collision link_name="hip_r_roll_link" friction="0.01"/>
    <gazebo reference="hip_r_pitch_link">
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <mu1>0.01</mu1>
      <maxVel>10.0</maxVel>
      <minDepth>0.0001</minDepth>
      <maxContacts>6</maxContacts>
      <selfCollide>false</selfCollide>
      <dampingFactor>0</dampingFactor>
    </gazebo>
    <xacro:default_link_collision link_name="thigh_r_active_link" friction="0.0"/>
    <xacro:default_link_collision link_name="shin_r_active_link" friction="0.01"/>
    <xacro:default_link_collision link_name="thigh_r_middle_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="thigh_r_rear_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="knee_r_passive_link" friction="0.01"/>
    <xacro:default_link_collision link_name="shin_r_front_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="shin_r_rear_passive_link" friction="0.0"/>
    <xacro:default_link_collision link_name="ankle_r_pitch_passive_link" friction="0.01"/>
    <xacro:default_link_collision link_name="ankle_r_roll_link" friction="0.0"/>
    <gazebo reference="ankle_r_yaw_link">
      <kp>2000000.0</kp>
      <kd>200.0</kd>
      <mu1>1.0</mu1>
      <maxVel>1.0</maxVel>
      <minDepth>0.0001</minDepth>
      <maxContacts>10</maxContacts>
      <selfCollide>false</selfCollide>
      <dampingFactor>0.0</dampingFactor>
    </gazebo>
  </xacro:macro>
</robot>
