<?xml version="1.0"?>
<launch>
  <arg name="camera_info_url"
    default="file://$(find kuroko_bringup)/config/usb_camera_info.yaml"/>
  <!-- Start USB camera node -->
  <!-- The widest viewing angle at this resolution. -->
  <node name="usb_cam" pkg="usb_cam" type="usb_cam_node" output="screen">
    <param name="video_device" value="/dev/video0"/>
    <param name="image_width" value="1920"/>
    <param name="image_height" value="1200"/>
    <param name="framerate" value="30"/>
    <param name="pixel_format" value="mjpeg"/>
    <param name="camera_name" value="usb_cam"/>
    <param name="camera_frame_id" value="usb_cam_frame"/>
    <param name="camera_info_url" value="$(arg camera_info_url)"/>
    <remap from="~image_raw" to="/camera/raw/image"/>
    <remap from="~camera_info" to="/camera/raw/camera_info"/>
  </node>

  <!-- Resize the image to half the original size -->
  <node name="image_resizer" pkg="nodelet" type="nodelet"
    args="standalone image_proc/resize" output="screen">
    <param name="width" value="960"/>
    <param name="height" value="600"/>
    <remap from="image" to="/camera/raw/image"/>
    <remap from="camera_info" to="/camera/raw/camera_info"/>
    <remap from="~image" to="/camera/resized/image"/>
    <remap from="~camera_info" to="/camera/resized/camera_info"/>
  </node>
</launch>
